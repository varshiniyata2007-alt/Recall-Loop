# ==============================================================================
# RECALLLOOP: AI Product Memory Agent - Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. HINDSIGHT REAL SEMANTIC MEMORY INTEGRATION (MANDATORY)
# Official Docs: https://hindsight.vectorize.io/
# GitHub Repo:   https://github.com/vectorize-io/hindsight
# ------------------------------------------------------------------------------
# OPTION A: HINDSIGHT CLOUD (RECOMMENDED & FASTEST)
# 1. Sign up for free at: https://ui.hindsight.vectorize.io/signup
# 2. Go to the "Connect" page and click "Generate API Key".
# 3. Paste your key below (starts with hsk_...):
HINDSIGHT_API_KEY=hsk_your_vectorize_hindsight_key_here

# Hindsight Cloud API URL:
HINDSIGHT_API_URL=https://api.hindsight.vectorize.io

# Dedicated Memory Bank ID in Hindsight:
HINDSIGHT_BANK_ID=recallloop-product-memory

# ------------------------------------------------------------------------------
# OPTION B: LOCAL HINDSIGHT SERVER (SELF-HOSTED EMBEDDED ENGINE)
# 1. Run the local Hindsight server:
#    Double-click start_hindsight.bat OR run in cmd:
#    start_hindsight.bat
# 2. Configure below:
#    HINDSIGHT_API_URL=http://127.0.0.1:8888
#    HINDSIGHT_API_KEY=
# ------------------------------------------------------------------------------

# ------------------------------------------------------------------------------
# 2. GROQ API (LLM INFERENCE FOR COMPLAINT ANALYSIS & INSIGHTS)
# Get a free key at: https://console.groq.com/
# ------------------------------------------------------------------------------
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ------------------------------------------------------------------------------
# 3. BACKEND SERVER CONFIGURATION
# ------------------------------------------------------------------------------
PORT=8000
HOST=127.0.0.1
DEBUG=true
